generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (Tomados del diagrama)
// ==========================================

enum TurnoEstado {
  Pendiente
  Confirmado
  Cancelado
  Reprogramado
}

enum DiaSemana {
  Lunes
  Martes
  Miercoles
  Jueves
  Viernes
  Sabado
  Domingo
}

enum Rol {
  PACIENTE
  SECRETARIA
  MEDICO
}

// ==========================================
// MODELOS / TABLAS
// ==========================================

model Usuario {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  passwordHash String
  nombre       String
  apellido     String
  dni          String  @unique
  email        String  @unique
  fotoPerfil   String?
  rol          Rol     @default(PACIENTE)

  // Herencia/Relaciones de Roles (1:1)
  medico     Medico?
  paciente   Paciente?
  secretaria Secretaria?
}

model Medico {
  id        Int @id @default(autoincrement())
  usuarioId Int @unique

  // onDelete: Cascade -> el rol es una extension del usuario: no existe sin el
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  especialidad String
  matricula    String @unique

  // Relaciones
  historiasClinicas HistoriaClinica[]
  agenda            Agenda?
  turnos            Turno[]
  bloqueos          BloqueoHorario[]
}

model Paciente {
  id        Int @id @default(autoincrement())
  usuarioId Int @unique

  // onDelete: Cascade -> el rol es una extension del usuario: no existe sin el
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  fechaNacimiento DateTime
  sexo            String
  telefono        String

  // Relaciones
  historiaClinica HistoriaClinica?
  turnos          Turno[]
  coberturas      Cobertura[]
}

model Secretaria {
  id        Int @id @default(autoincrement())
  usuarioId Int @unique

  // onDelete: Cascade -> el rol es una extension del usuario: no existe sin el
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  turnos Turno[]
}

model HistoriaClinica {
  id         Int @id @default(autoincrement())
  pacienteId Int @unique

  // onDelete: Cascade -> la historia clinica es del paciente y se va con el
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  medicoId Int

  // onDelete: Restrict -> no se borra al medico responsable de historias clinicas
  medico Medico @relation(fields: [medicoId], references: [id], onDelete: Restrict)

  alergias     Alergia[]
  antecedentes Antecedente[]

  entradas EntradaClinica[]
}

model EntradaClinica {
  id                Int @id @default(autoincrement())
  historiaClinicaId Int

  // onDelete: Cascade -> una entrada no existe fuera de su historia
  historiaClinica HistoriaClinica @relation(fields: [historiaClinicaId], references: [id], onDelete: Cascade)

  diagnostico   String
  evolucion     String
  fecha         DateTime @default(now())
  observaciones String
}

model Alergia {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  historias HistoriaClinica[]
}

model Antecedente {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  historias HistoriaClinica[]
}

model ObraSocial {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  coberturas Cobertura[]
}

model Cobertura {
  pacienteId   Int
  obraSocialId Int

  nroAfiliado String
  plan        String
  vigente     Boolean @default(true)

  paciente   Paciente   @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  obraSocial ObraSocial @relation(fields: [obraSocialId], references: [id], onDelete: Restrict)

  @@id([pacienteId, obraSocialId])
  @@unique([obraSocialId, nroAfiliado])
}

model Agenda {
  id       Int @id @default(autoincrement())
  medicoId Int @unique

  medico Medico @relation(fields: [medicoId], references: [id], onDelete: Cascade)

  horariosAtencion DiaSemana[]
  intervaloTurno   Int
}

model BloqueoHorario {
  id       Int @id @default(autoincrement())
  medicoId Int

  medico Medico @relation(fields: [medicoId], references: [id], onDelete: Cascade)

  desde  DateTime
  hasta  DateTime
  motivo String?
}

model Turno {
  id           Int         @id @default(autoincrement())
  estado       TurnoEstado @default(Pendiente)
  fechaHora    DateTime
  idWhatsapp   String?
  pagoValidado Boolean     @default(false)

  medicoId Int
  medico   Medico @relation(fields: [medicoId], references: [id], onDelete: Restrict)

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)

  secretariaId Int?
  secretaria   Secretaria? @relation(fields: [secretariaId], references: [id], onDelete: SetNull)

  asistenteIA AsistenteIA?
}

model AsistenteIA {
  id          Int    @id @default(autoincrement())
  nroWhatsApp String
  turnoId     Int    @unique

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)
}
