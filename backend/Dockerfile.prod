# Imagen de PRODUCCIÓN (Render). La de desarrollo sigue siendo ./Dockerfile.
# Dos etapas: la 1 compila TypeScript; la 2 se queda solo con lo necesario para correr.

# ---------- Etapa 1: compilar ----------
FROM node:22-alpine AS build

ENV CHECKPOINT_DISABLE=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

# Los query engines de Prisma necesitan openssl en Alpine
RUN apk add --no-cache openssl

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx prisma generate && npm run build

# ---------- Etapa 2: correr ----------
FROM node:22-alpine

ENV NODE_ENV=production \
    CHECKPOINT_DISABLE=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

RUN apk add --no-cache openssl

WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma

# Sin ARG ni ENV con secretos: DATABASE_URL, JWT_SECRET y FRONTEND_URL
# entran al correr (panel de Render), no al construir.
EXPOSE 3000

# Aplica las migraciones commiteadas y arranca la API ya compilada.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
