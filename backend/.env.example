# ---------------------------------------------------------------------------
# Plantilla de variables de entorno.
# Copiar a `.env` y completar con valores propios:
#     cp backend/.env.example backend/.env
# El archivo `.env` esta en .gitignore: NUNCA se commitea.
# ---------------------------------------------------------------------------

# --- Aplicacion ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Base de datos (servicio "db" de docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=imos_turnos_db
POSTGRES_PORT=5432

# --- Prisma ---
# IMPORTANTE: Docker Compose NO expande ${VARIABLE} dentro de un env_file.
# Hay que escribir la URL completa a mano, repitiendo los valores de arriba.
# El host es "db" porque es el nombre del servicio dentro de la red de Compose.
DATABASE_URL=postgresql://postgres:cambiar_esta_password@db:5432/imos_turnos_db

# Si corres Prisma desde tu maquina (fuera de Docker), usa localhost:
# DATABASE_URL=postgresql://postgres:cambiar_esta_password@localhost:5432/imos_turnos_db

# --- Sin telemetria ---
# CHECKPOINT_DISABLE   -> desactiva el reporte de uso de Prisma
# PRISMA_HIDE_UPDATE_MESSAGE -> oculta el aviso de nueva version
CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1

# --- Autenticacion (JWT) ---
# JWT_SECRET: string larga y aleatoria, distinta por entorno. NUNCA reutilizar este placeholder.
JWT_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=1d
SALT_ROUNDS=10
