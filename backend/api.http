@baseUrl = http://localhost:3000

### ==========================================
### AUTH
### ==========================================

### Registro exitoso -> 201 (sin passwordHash en la respuesta)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "username": "jperez",
  "password": "Paciente1234",
  "nombre": "Julia",
  "apellido": "Pérez",
  "dni": "41222333",
  "email": "julia.perez@gmail.com"
}

### Registro con email repetido -> 409 (Prisma P2002)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "username": "jperez2",
  "password": "Paciente1234",
  "nombre": "Julia",
  "apellido": "Pérez",
  "dni": "41222334",
  "email": "julia.perez@gmail.com"
}

### Registro con contraseña débil -> 400 (Zod)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "username": "jperez3",
  "password": "1234",
  "nombre": "Julia",
  "apellido": "Pérez",
  "dni": "41222335",
  "email": "otra.julia@gmail.com"
}

### Login correcto -> 200 con token (usuario sembrado por el seed)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "maria.flores@gmail.com",
  "password": "Paciente1234"
}

### Login con contraseña incorrecta -> 401 (mensaje genérico)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "maria.flores@gmail.com",
  "password": "ContraseñaIncorrecta1"
}

### Login con email inexistente -> 401 (mismo mensaje genérico)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "no.existe@gmail.com",
  "password": "Paciente1234"
}

### Yo sin token -> 401
GET {{baseUrl}}/api/auth/yo

### Yo con token inválido -> 401
GET {{baseUrl}}/api/auth/yo
Authorization: Bearer token-invalido

### Yo con token válido -> 200 (pegar el token devuelto por el login correcto)
GET {{baseUrl}}/api/auth/yo
Authorization: Bearer PEGAR_TOKEN_AQUI

### ==========================================
### TURNOS
### ==========================================

### Listar turnos
GET {{baseUrl}}/api/turnos

### Ver un turno creado
GET {{baseUrl}}/api/turnos/3

### Ver un turno que no existe -> 404
GET {{baseUrl}}/api/turnos/999

### Crear un turno
POST {{baseUrl}}/api/turnos
Content-Type: application/json

{
  "estado": "Pendiente",
  "fechaHora": "2026-08-27T11:00:00.000Z",
  "idWhatsapp": "WA-TEST-001",
  "pagoValidado": false,
  "medicoId": 1,
  "pacienteId": 1,
  "secretariaId": 1
}

### Editar un turno
PUT {{baseUrl}}/api/turnos/3
Content-Type: application/json

{
  "estado": "Confirmado",
  "fechaHora": "2026-08-27T12:00:00.000Z",
  "idWhatsapp": "WA-TEST-001",
  "pagoValidado": true,
  "medicoId": 1,
  "pacienteId": 1,
  "secretariaId": 1
}

### Editar un turno que no existe -> 404
PUT {{baseUrl}}/api/turnos/999
Content-Type: application/json

{
  "estado": "Confirmado",
  "fechaHora": "2026-08-27T12:00:00.000Z",
  "idWhatsapp": "WA-TEST-404",
  "pagoValidado": true,
  "medicoId": 1,
  "pacienteId": 1,
  "secretariaId": 1
}

### Cancelar (borrar) un turno
DELETE {{baseUrl}}/api/turnos/3

### Cancelar el mismo turno de nuevo -> 404
DELETE {{baseUrl}}/api/turnos/3

### Crear turno con body inválido -> 400 (Zod)
POST {{baseUrl}}/api/turnos
Content-Type: application/json
{
  "estado": "EstadoInvalidoQueFalleZod",
  "pagoValidado": "no-es-boolean"
}

### Ver turno con ID no numérico -> 400 (Zod o validación de params)
GET {{baseUrl}}/api/turnos/abc

### Crear turno con violacion de FK (medicoId no existe) -> 409 (Prisma P2003)
POST {{baseUrl}}/api/turnos
Content-Type: application/json
{
  "estado": "Pendiente",
  "fechaHora": "2026-08-27T11:00:00.000Z",
  "idWhatsapp": "WA-TEST-002",
  "pagoValidado": false,
  "medicoId": 99999,
  "pacienteId": 1,
  "secretariaId": 1
}