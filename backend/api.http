@baseUrl = http://localhost:3000

### ==========================================
### 1. AUTENTICACIÓN Y LOGINS POR ROL (SEED)
### ==========================================

### Login Médico -> 200 (Captura token de Médico)
# @name loginMedico
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "carlos.gomez@clinica.com",
  "password": "Medico1234"
}

### Variable para el token de Médico
@tokenMedico = {{loginMedico.response.body.token}}


### Login Secretaria -> 200 (Captura token de Secretaria)
# @name loginSecretaria
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ana.martinez@clinica.com",
  "password": "Secretaria1234"
}

### Variable para el token de Secretaria
@tokenSecretaria = {{loginSecretaria.response.body.token}}


### Login Paciente -> 200 (Captura token de Paciente)
# @name loginPaciente
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "maria.flores@gmail.com",
  "password": "Paciente1234"
}

### Variable para el token de Paciente
@tokenPaciente = {{loginPaciente.response.body.token}}


### ==========================================
### 2. PRUEBAS DE REGISTRO Y LOGIN (AUTH)
### ==========================================

### Registro exitoso -> 201 (sin passwordHash en la respuesta)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "username": "jperez",
  "password": "Paciente1234",
  "nombre": "Julia",
  "apellido": "Pérez",
  "dni": "41222333",
  "email": "julia.perez@gmail.com",
  "telefono": "5492344555555",
  "sexo": "Femenino",
  "fechaNacimiento": "1995-04-12"
}

### Registro con email repetido -> 409 ("El email ya se encuentra registrado")
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "username": "jperez2",
  "password": "Paciente1234",
  "nombre": "Julia",
  "apellido": "Pérez",
  "dni": "41222334",
  "email": "julia.perez@gmail.com",
  "telefono": "5492344555555",
  "sexo": "Femenino",
  "fechaNacimiento": "1995-04-12"
}

### Registro con contraseña débil -> 400 (Zod)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "username": "jperez3",
  "password": "1234",
  "nombre": "Julia",
  "apellido": "Pérez",
  "dni": "41222335",
  "email": "otra.julia@gmail.com",
  "telefono": "5492344555555",
  "sexo": "Femenino",
  "fechaNacimiento": "1995-04-12"
}

### Login con contraseña incorrecta -> 401 (mensaje genérico)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "maria.flores@gmail.com",
  "password": "ContraseñaIncorrecta1"
}

### Login con email inexistente -> 401 (mensaje genérico)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "no.existe@gmail.com",
  "password": "Paciente1234"
}


### ==========================================
### 3. PRUEBAS DE AUTENTICACIÓN (/yo)
### ==========================================

### Yo sin token -> 401 Unauthorized
GET {{baseUrl}}/api/auth/yo

### Yo con token inválido -> 401 Unauthorized
GET {{baseUrl}}/api/auth/yo
Authorization: Bearer token-invalido

### Yo con token válido (Médico) -> 200 OK
GET {{baseUrl}}/api/auth/yo
Authorization: Bearer {{tokenMedico}}


### ==========================================
### 4. CATÁLOGOS Y CARTILLA PÚBLICA
### ==========================================

### Obtener Obras Sociales (Público/General) -> 200 OK
GET {{baseUrl}}/api/obras-sociales

### Obtener Especialidades (Público/General) -> 200 OK
GET {{baseUrl}}/api/especialidades

### Obtener Cartilla de Médicos sin token (Público según Matriz Secc. 7) -> 200 OK
GET {{baseUrl}}/api/medicos

### Obtener Cartilla de Médicos con token -> 200 OK
GET {{baseUrl}}/api/medicos
Authorization: Bearer {{tokenPaciente}}


### ==========================================
### 5. LECTURAS DE PACIENTES Y USUARIOS (RBAC)
### ==========================================

### Listar Pacientes sin token -> 401 Unauthorized
GET {{baseUrl}}/api/pacientes

### Listar Pacientes como Paciente -> 403 Forbidden
GET {{baseUrl}}/api/pacientes
Authorization: Bearer {{tokenPaciente}}

### Listar Pacientes como Secretaria -> 200 OK
GET {{baseUrl}}/api/pacientes
Authorization: Bearer {{tokenSecretaria}}

### Listar Pacientes como Médico -> 200 OK
GET {{baseUrl}}/api/pacientes
Authorization: Bearer {{tokenMedico}}

### Alta de paciente por la secretaria -> 201 (usuario y contraseña inicial = DNI)
POST {{baseUrl}}/api/pacientes
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "nombre": "Lucía",
  "apellido": "Gómez",
  "dni": "40111222",
  "email": "lucia.gomez@gmail.com",
  "telefono": "5492344666666",
  "sexo": "Femenino",
  "fechaNacimiento": "1998-11-03"
}

### Alta con el mismo DNI -> 409 ("El DNI ya se encuentra registrado")
POST {{baseUrl}}/api/pacientes
Authorization: Bearer {{tokenSecretaria}}
Content-Type: application/json

{
  "nombre": "Otra",
  "apellido": "Persona",
  "dni": "40111222",
  "email": "otra.persona@gmail.com",
  "telefono": "5492344666667",
  "sexo": "Otro",
  "fechaNacimiento": "1990-01-01"
}

### Alta de paciente como Paciente -> 403 Forbidden
POST {{baseUrl}}/api/pacientes
Authorization: Bearer {{tokenPaciente}}
Content-Type: application/json

{}

### Listar Usuarios sin token -> 401 Unauthorized
GET {{baseUrl}}/api/usuarios

### Listar Usuarios como Paciente -> 403 Forbidden
GET {{baseUrl}}/api/usuarios
Authorization: Bearer {{tokenPaciente}}

### Listar Usuarios como Secretaria -> 200 OK
GET {{baseUrl}}/api/usuarios
Authorization: Bearer {{tokenSecretaria}}


### ==========================================
### 6. TURNOS: CONTROL DE ACCESO (401 y 403)
### ==========================================

### Listar turnos sin token -> 401 Unauthorized
GET {{baseUrl}}/api/turnos

### Listar turnos con rol Paciente -> 200 OK (solo los propios)
GET {{baseUrl}}/api/turnos
Authorization: Bearer {{tokenPaciente}}

### Listar turnos con rol Médico -> 200 OK
GET {{baseUrl}}/api/turnos
Authorization: Bearer {{tokenMedico}}


### ==========================================
### 7. TURNOS: OPERACIONES CRUD Y VALIDACIONES
### ==========================================

### Crear turno exitoso (Médico/Administrativo) -> 201 Created
# @name crearTurno
POST {{baseUrl}}/api/turnos
Authorization: Bearer {{tokenMedico}}
Content-Type: application/json

{
  "estado": "Pendiente",
  "fechaHora": "2026-08-27T11:00:00.000Z",
  "idWhatsapp": "WA-TEST-001",
  "pagoValidado": false,
  "medicoId": 1,
  "pacienteId": 1,
  "secretariaId": 1
}

### Guardar ID del turno recién creado
@turnoId = {{crearTurno.response.body.id}}

### Ver el turno recién creado -> 200 OK
GET {{baseUrl}}/api/turnos/{{turnoId}}
Authorization: Bearer {{tokenMedico}}

### Ver un turno que no existe -> 404 Not Found
GET {{baseUrl}}/api/turnos/99999
Authorization: Bearer {{tokenMedico}}

### Ver turno con ID no numérico -> 400 Bad Request (Zod params)
GET {{baseUrl}}/api/turnos/abc
Authorization: Bearer {{tokenMedico}}

### Editar un turno existente -> 200 OK
PUT {{baseUrl}}/api/turnos/{{turnoId}}
Authorization: Bearer {{tokenMedico}}
Content-Type: application/json

{
  "estado": "Confirmado",
  "fechaHora": "2026-08-27T12:00:00.000Z",
  "idWhatsapp": "WA-TEST-001",
  "pagoValidado": true,
  "medicoId": 1,
  "pacienteId": 1,
  "secretariaId": 1
}

### Editar un turno que no existe -> 404 Not Found
PUT {{baseUrl}}/api/turnos/99999
Authorization: Bearer {{tokenMedico}}
Content-Type: application/json

{
  "estado": "Confirmado",
  "fechaHora": "2026-08-27T12:00:00.000Z"
}

### Crear turno con body inválido -> 400 Bad Request (Zod validation)
POST {{baseUrl}}/api/turnos
Authorization: Bearer {{tokenMedico}}
Content-Type: application/json

{
  "estado": "EstadoInvalidoQueFalleZod",
  "pagoValidado": "no-es-boolean"
}

### Crear turno con violación de FK (medicoId no existe) -> 409 Conflict (Prisma P2003)
POST {{baseUrl}}/api/turnos
Authorization: Bearer {{tokenMedico}}
Content-Type: application/json

{
  "estado": "Pendiente",
  "fechaHora": "2026-08-27T11:00:00.000Z",
  "idWhatsapp": "WA-TEST-002",
  "pagoValidado": false,
  "medicoId": 99999,
  "pacienteId": 1
}

### ==========================================
### 7b. TURNOS DEL PACIENTE (titularidad)
### ==========================================

### Paciente pide un turno -> 201 Created (Pendiente; el pacienteId del body se ignora)
# @name pedirTurno
POST {{baseUrl}}/api/turnos
Authorization: Bearer {{tokenPaciente}}
Content-Type: application/json

{
  "medicoId": 1,
  "fechaHora": "2030-03-14T13:00:00.000Z",
  "pacienteId": 999
}

### Paciente ve su turno -> 200 OK
GET {{baseUrl}}/api/turnos/{{pedirTurno.response.body.id}}
Authorization: Bearer {{tokenPaciente}}

### Paciente pide un turno sin fechaHora -> 400 Bad Request
POST {{baseUrl}}/api/turnos
Authorization: Bearer {{tokenPaciente}}
Content-Type: application/json

{
  "medicoId": 1
}

### Paciente cancela su turno Pendiente -> 200 OK (estado Cancelado)
PATCH {{baseUrl}}/api/turnos/{{pedirTurno.response.body.id}}/cancelar
Authorization: Bearer {{tokenPaciente}}

### Paciente cancela el mismo turno de nuevo -> 409 Conflict ("El turno ya está cancelado")
PATCH {{baseUrl}}/api/turnos/{{pedirTurno.response.body.id}}/cancelar
Authorization: Bearer {{tokenPaciente}}

### Paciente cancela un turno Confirmado -> 409 Conflict ("El turno ya fue confirmado; comunicate con el consultorio")
### (usar el id de un turno Confirmado del paciente, por ejemplo el del seed)
PATCH {{baseUrl}}/api/turnos/1/cancelar
Authorization: Bearer {{tokenPaciente}}

### Paciente ve un turno de otro paciente -> 404 Not Found (no 403: no se revela que existe)
GET {{baseUrl}}/api/turnos/{{turnoId}}
Authorization: Bearer {{tokenPaciente}}

### Eliminar el turno creado -> 200 OK
DELETE {{baseUrl}}/api/turnos/{{turnoId}}
Authorization: Bearer {{tokenMedico}}

### Eliminar el mismo turno de nuevo -> 404 Not Found
DELETE {{baseUrl}}/api/turnos/{{turnoId}}
Authorization: Bearer {{tokenMedico}}

### ==========================================
### 8. HISTORIA CLÍNICA (matriz de permisos §10)
### ==========================================
### :id es el id de Paciente (no el de Usuario)

### Médico ve la historia de un paciente -> 200 (consultas de la más nueva a la más vieja)
GET {{baseUrl}}/api/pacientes/1/historia-clinica
Authorization: Bearer {{tokenMedico}}

### Médico registra una consulta -> 201 (devuelve la historia actualizada)
POST {{baseUrl}}/api/pacientes/1/historia-clinica/entradas
Authorization: Bearer {{tokenMedico}}
Content-Type: application/json

{
  "diagnostico": "Esguince de tobillo grado I",
  "evolucion": "Reposo relativo 7 días, hielo y control en 10 días",
  "observaciones": ""
}

### Médico reemplaza alergias y antecedentes -> 200
PUT {{baseUrl}}/api/pacientes/1/historia-clinica
Authorization: Bearer {{tokenMedico}}
Content-Type: application/json

{
  "alergias": ["Penicilina"],
  "antecedentes": ["Hipertensión"]
}

### Secretaria pide una historia -> 403
GET {{baseUrl}}/api/pacientes/1/historia-clinica
Authorization: Bearer {{tokenSecretaria}}

### ==========================================
### 9. CAMBIO DE CONTRASEÑA
### ==========================================

### Contraseña actual incorrecta -> 400 (no 401: el usuario sí está logueado)
PATCH {{baseUrl}}/api/auth/password
Authorization: Bearer {{tokenPaciente}}
Content-Type: application/json

{
  "passwordActual": "NoEsMiPassword1",
  "passwordNueva": "Segura123"
}
